{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "sunny-private-sounds",
  "main": "worker.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "sunnyinnolab.com/sounds", "zone_name": "sunnyinnolab.com" },
    { "pattern": "sunnyinnolab.com/sounds/*", "zone_name": "sunnyinnolab.com" }
  ],
  "vars": {
    "DRIVE_FOLDERS": {
      "bgm/subway-master": "1ljzHAdOteiB3iPGnSW2MNO08AFyX8Ocw",
      "sound-effect/subway-master": "1WQZ93DdOXvbE1NC-IGMr2aRz8tgAgS1n"
    }
  },
  "durable_objects": {
    "bindings": [{ "name": "SOUND_ORDERS", "class_name": "SoundOrder" }]
  },
  "migrations": [{ "tag": "sound-order-v1", "new_sqlite_classes": ["SoundOrder"] }],
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "2026102201", "simple": { "limit": 5, "period": 60 } }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.html", "**/*.css", "**/*.txt", "**/client.js"], "fallthrough": true }
  ],
  "observability": { "enabled": false }
}
